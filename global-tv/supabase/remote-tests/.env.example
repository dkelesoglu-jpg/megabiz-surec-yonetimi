# Bu dosya yalnızca örnektir. Gerçek değerler .env.local dosyasına (git'e girmez) veya ortam değişkenlerine yazılır.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Yalnızca test kullanıcılarını oluşturup temizlemek için. Asla uygulamaya veya panele konmaz.
SUPABASE_SECRET_KEY=
# Testler kullanıcı oluşturur ve kayıt yazar; yalnızca geliştirme/test projesinde çalıştırın.
GLOBALTV_REMOTE_TESTS=1
